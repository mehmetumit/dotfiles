#!/bin/sh
#                                 _
#   ___ ___  _ ____   _____ _ __ (_) ___ _ __   ___ ___  ___
#  / __/ _ \| '_ \ \ / / _ \ '_ \| |/ _ \ '_ \ / __/ _ \/ __|
# | (_| (_) | | | \ V /  __/ | | | |  __/ | | | (_|  __/\__ \
#  \___\___/|_| |_|\_/ \___|_| |_|_|\___|_| |_|\___\___||___/
#
#
# Increase scroll key speed
xset r rate 300 50
# Swap capslock and escape for vim
# setxkbmap -option caps:swapescape

get_git_branch() {
    git branch 2> /dev/null | awk '/*/{printf "(%s)", $2}'
}
get_git_status() {
    g_status=$(git status --porcelain 2>/dev/null || printf '0')
    [ ! -z "$g_status" ] && [ ! "$g_status" = '0' ] && printf '*' || printf ''
}
# Edit files from current location
edit_files() {
    files=$(find . -type f -not -path "*/\.git/*" -print 2>/dev/null | fzf --header='edit_files' --preview 'bat --style=numbers --color=always --line-range :500 {}') && $EDITOR -p "$files"
}
# Edit dotfiles with fzf
edit_dotfiles() {
    files=$(find "$HOME/dotfiles" -type f -not -path "*/\.git/*" -print | fzf --header='edit_dotfiles' --preview 'bat --style=numbers --color=always --line-range :500 {}' -m) && $EDITOR -p "$files"
}
# Start tmux at selected projects path
start_tmux_at_projects() {
    project_path=$(find "$HOME/Projects" -maxdepth 2 -type d -not -path "*/\.git/*" -print | fzf --no-multi --header='start_tmux_at_projects') && cd "$project_path" && tmux && cd - || return
}
# Start tmux at selected directory
start_tmux() {
    selected_path=$(find . -maxdepth 4 -type d -not -path "*/\.git/*" -print | fzf --no-multi --header='start_tmux') && cd "$selected_path" && tmux && cd - || return
}
# Change directory with fzf
quick_cd() {
    cd "$(find . -type d -not -path "*/\.git/*" -print | fzf --header='quick_cd' --no-multi)" || exit
}
# Use ranger to change directory
ranger_cd() {
    tmp="$(mktemp)"
    ranger --choosedir="$tmp" "$@"
    if [ -f "$tmp" ]; then
        dir="$(cat "$tmp")"
        rm -f "$tmp"
        [ -d "$dir" ] && [ "$dir" != "$(pwd)" ] && cd "$dir" || exit
    fi
}
disk_usage() {
    du -h --max-depth=1 | sort -hr
}
search_command() {
    sh_name=$(ps -ocomm= -q $$)
    [ "$sh_name" = "zsh" ] && print -z "$(cat "$HOME/.bash_history" "$HOME/.zsh_history" | fzf --header='search_command')" || echo "$sh_name not supported!"
}

# Usage:
#   tun                               # Interactive menu
#   tun vpn                           # Choose VPN profile with fzf
#   tun vpn work                      # Match work.conf or work.ovpn
#   tun vpn work.conf                 # Exact VPN filename
#   tun ssh work/server               # Normal SSH connection
#   tun local work/server 9191 443    # Local 9191 -> remote localhost:443
#   tun reverse work/server 9000 3000 # Remote 9000 -> local localhost:3000
#   tun socks work/server             # Local SOCKS5 port 9090
#   tun socks work/server 1080        # Custom SOCKS5 port

conn-vpn() {
    local vpn_dir="$HOME/vpn" group="VPN"
    local requested="${1:-}" profiles matches count
    local relative profile filename ext client file
    local entry_path record remaining
    local username password totp use_keepass
    local rc started elapsed failures=0
    local retry_delay=5 max_fast_failures=3

    [ "$#" -le 1 ] || {
        printf 'Usage: conn-vpn [profile-name|filename]\n' >&2
        return 2
    }
    [ -d "$vpn_dir" ] || {
        printf 'VPN directory not found: %s\n' "$vpn_dir" >&2
        return 1
    }

    profiles=$(
        find "$vpn_dir" -type f \( -name '*.conf' -o -name '*.ovpn' \) |
        while IFS= read -r file; do
            printf '%s\n' "${file#"$vpn_dir"/}"
        done | sort
    )
    [ -n "$profiles" ] || {
        printf 'No VPN profiles found in %s\n' "$vpn_dir" >&2
        return 1
    }

    if [ -n "$requested" ]; then
        # Match relative path, filename or either without extension.
        matches=$(printf '%s\n' "$profiles" | awk -v q="$requested" '
            {
                relative=$0
                base=relative
                sub(/^.*\//, "", base)
                relative_stem=relative
                base_stem=base
                sub(/\.(conf|ovpn)$/, "", relative_stem)
                sub(/\.(conf|ovpn)$/, "", base_stem)
                if (q==relative || q==base || q==relative_stem || q==base_stem)
                    print relative
            }
        ')
        count=$(printf '%s\n' "$matches" | awk 'NF {n++} END {print n+0}')
        case "$count" in
            0) printf 'VPN profile not found: %s\n' "$requested" >&2; return 1 ;;
            1) relative="$matches" ;;
            *) printf 'Ambiguous VPN profile %s. Choose one of:\n%s\n' "$requested" "$matches" >&2; return 1 ;;
        esac
    else
        relative=$(printf '%s\n' "$profiles" |
            fzf --header='Select VPN Configuration') || return 1
        [ -n "$relative" ] || return 1
    fi

    profile="$vpn_dir/$relative"
    filename="${relative##*/}"
    ext="${filename##*.}"
    case "$ext" in
        conf) client="openconnect" ;;
        ovpn) client="openvpn" ;;
        *) return 1 ;;
    esac
    command -v "$client" >/dev/null 2>&1 || {
        printf '%s is not installed\n' "$client" >&2
        return 1
    }

    entry_path="$group/${filename%.*}"
    printf 'Selected VPN: %s\n' "$relative"

    (
        trap 'exit 130' INT
        trap 'exit 143' TERM
        while :; do
            username=""; password=""; totp=""; record=""; remaining=""
            use_keepass=0

            printf 'Looking for KeePass entry: %s\n' "$entry_path"
            if command -v keepass >/dev/null 2>&1; then
                if ! record=$(keepass show -a username -a password -t \
                    "$entry_path" </dev/tty 2>/dev/null); then
                    record=$(keepass show -a username -a password \
                        "$entry_path" </dev/tty 2>/dev/null) || record=""
                fi
                case "$record" in
                    *$'\n'*)
                        username="${record%%$'\n'*}"
                        remaining="${record#*$'\n'}"
                        case "$remaining" in
                            *$'\n'*)
                                password="${remaining%%$'\n'*}"
                                totp="${remaining#*$'\n'}"
                                ;;
                            *) password="$remaining" ;;
                        esac
                        [ -z "$username" ] || [ -z "$password" ] || use_keepass=1
                        ;;
                esac
            fi

            case "$totp" in
                ''|*[!0-9]*) totp="" ;;
            esac
            if [ "$use_keepass" -eq 1 ]; then
                printf 'Using KeePass: %s\n' "$entry_path"
            else
                printf 'KeePass credentials unavailable. Connecting directly.\n'
            fi

            printf '\nConnecting to %s...\n' "$relative"
            started=$(date +%s)
            (
                cd "$(dirname "$profile")" || exit 1
                case "$client" in
                    openvpn)
                        if [ "$use_keepass" -eq 1 ]; then
                            printf '%s\n%s\n' "$username" "$password" |
                                sudo -n openvpn \
                                    --config "$(basename "$profile")" \
                                    --auth-user-pass /dev/stdin
                        else
                            sudo -n openvpn \
                                --config "$(basename "$profile")" \
                                --auth-user-pass
                        fi
                        ;;
                    openconnect)
                        if [ "$use_keepass" -eq 1 ]; then
                            (
                                exec {input_fd}< <(
                                    printf '%s\n' "$password"
                                    [ -z "$totp" ] || printf '%s\n' "$totp"
                                    exec cat /dev/tty
                                )
                                feeder_pid=$!
                                trap '
                                    kill "$feeder_pid" 2>/dev/null
                                    wait "$feeder_pid" 2>/dev/null
                                    exec {input_fd}<&-
                                ' EXIT
                                sudo -n openconnect \
                                    --config "$(basename "$profile")" \
                                    --user="$username" \
                                    --passwd-on-stdin <&"$input_fd"
                            )
                        else
                            sudo -n openconnect --config "$(basename "$profile")"
                        fi
                        ;;
                esac
            )
            rc=$?
            elapsed=$(( $(date +%s) - started ))
            unset password totp record remaining
            case "$rc" in
                0) printf 'VPN disconnected normally.\n'; exit 0 ;;
                130|143) printf 'VPN connection interrupted.\n'; exit "$rc" ;;
            esac
            if [ "$elapsed" -lt 60 ]; then
                failures=$((failures + 1))
            else
                failures=0
            fi
            if [ "$failures" -ge "$max_fast_failures" ]; then
                printf 'Too many rapid failures. Stopping.\n' >&2
                exit "$rc"
            fi
            printf '\nVPN disconnected (exit code: %s). Retrying in %s seconds...\n' "$rc" "$retry_delay"
            sleep "$retry_delay" || exit 130
        done
    )
}

tun() {
    local ssh_config="$HOME/.ssh/config"
    local type selection server alias address ssh_settings has_key
    local group entries entry_count selected_entry entry_path fields
    local username password default_user auth_source
    local local_port="" remote_port="" local_host="" remote_host=""
    local local_bind="" remote_bind="" option="" forward="" port
    local exit_code menu entry entry_username

    # Direct mode, or interactive type selection.
    if [ "$#" -gt 0 ]; then
        type="$1"
        shift
    else
        type=$(printf '%s\n' \
            'VPN' 'SSH Connection' 'Local (-L)' 'Reverse (-R)' 'SOCKS5 (-D)' |
            fzf --header='Select Connection Type') || return 1
    fi

    case "$type" in
        VPN|vpn) conn-vpn "$@"; return $? ;;
        'SSH Connection'|ssh|connect) type=ssh ;;
        'Local (-L)'|local|-L) type=local ;;
        'Reverse (-R)'|reverse|-R) type=reverse ;;
        'SOCKS5 (-D)'|socks|socks5|-D) type=socks ;;
        *) printf 'Unknown connection type: %s\n' "$type" >&2; return 2 ;;
    esac

    [ -r "$ssh_config" ] || {
        printf 'SSH config not found: %s\n' "$ssh_config" >&2
        return 1
    }

    if [ "$#" -gt 0 ]; then
        server="$1"
        shift
    else
        selection=$(
            awk '
                tolower($1) == "host" {
                    for (i=2; i<=NF; i++) {
                        if ($i ~ /^#/) break
                        if ($i !~ /\// || $i ~ /[*?!]/ || $i ~ /^-/) continue
                        print $i
                    }
                }
            ' "$ssh_config" |
            sort -u |
            while IFS= read -r alias; do
                address=$(ssh -G "$alias" 2>/dev/null |
                    awk 'tolower($1)=="hostname" {print $2; exit}')
                printf '%-32s  %s\n' "$alias" "${address:-N/A}"
            done |
            fzf --header='Select SSH Host'
        ) || return 1
        [ -n "$selection" ] || return 1
        server=${selection%% *}
    fi
    case "$server" in
        ''|-*) printf 'Invalid SSH host: %s\n' "$server" >&2; return 1 ;;
    esac

    # Ignore implicit default identities while looking for configured keys.
    ssh_settings=$(ssh -G -o IdentityFile=none "$server" 2>/dev/null) || {
        printf 'Unable to inspect SSH config: %s\n' "$server" >&2
        return 1
    }
    has_key=$(printf '%s\n' "$ssh_settings" |
        awk 'tolower($1)=="identityfile" && tolower($2)!="none" {print "yes"; exit}')
    default_user=$(printf '%s\n' "$ssh_settings" |
        awk 'tolower($1)=="user" {print $2; exit}')

    # Use KeePass if there is no explicitly configured identity.
    if [ "$has_key" != yes ]; then
        command -v sshpass >/dev/null 2>&1 || {
            printf 'sshpass is required\n' >&2
            return 1
        }
        group="SSH/$server"
        entries=""; selected_entry=""; username=""; password=""
        auth_source='manual password'
        printf 'Looking for KeePass entries: %s\n' "$group"

        if command -v keepass >/dev/null 2>&1; then
            if ! entries=$(keepass ls -R -f "$group" </dev/tty); then
                printf 'KeePass lookup failed; using manual credentials.\n' >&2
                entries=""
            fi
        fi
        entries=$(printf '%s\n' "$entries" |
            awk 'NF && $0 !~ /\/$/ && $0 !~ /(^|\/)\[empty\]$/ {print}')
        entry_count=$(printf '%s\n' "$entries" |
            awk 'NF {n++} END {print n+0}')
        case "$entry_count" in
            0) printf 'No KeePass credentials found for %s\n' "$server" ;;
            1) selected_entry="$entries"; printf 'Using KeePass entry: %s\n' "$selected_entry" ;;
            *)
                menu=""
                while IFS= read -r entry; do
                    [ -n "$entry" ] || continue
                    entry_username=$(keepass show -a username \
                        "$group/$entry" </dev/tty) || return 1
                    entry_username="${entry_username%%$'\n'*}"
                    menu="${menu}$(printf '%-32s %s\t%s' \
                        "$entry" "$entry_username" "$entry")"$'\n'
                done <<< "$entries"
                selection=$(printf '%s' "$menu" |
                    fzf --delimiter=$'\t' --with-nth=1 \
                        --header='Select SSH Credential') || return 1
                [ -n "$selection" ] || return 1
                selected_entry="${selection##*$'\t'}"
                ;;
        esac
        if [ -n "$selected_entry" ]; then
            entry_path="$group/$selected_entry"
            fields=$(keepass show -a username -a password \
                "$entry_path" </dev/tty) || return 1
            case "$fields" in
                *$'\n'*) username="${fields%%$'\n'*}"; password="${fields#*$'\n'}" ;;
                *) printf 'Unexpected KeePass output\n' >&2; return 1 ;;
            esac
            auth_source='KeePass'
        fi
        if [ -z "$username" ]; then
            printf 'SSH Username [%s]: ' "$default_user"
            IFS= read -r username || return 1
            username="${username:-$default_user}"
        fi
        [ -n "$username" ] || { printf 'SSH username cannot be empty\n' >&2; return 1; }
        if [ -z "$password" ]; then
            printf 'SSH Password for %s@%s: ' "$username" "$server"
            IFS= read -rs password || return 1
            printf '\n'
            auth_source='manual password'
        fi
        [ -n "$password" ] || { printf 'SSH password cannot be empty\n' >&2; return 1; }
    fi

    # Tunnel options: CLI supplied -> no prompts; otherwise interactive.
    case "$type" in
        ssh)
            [ "$#" -eq 0 ] || {
                printf 'Usage: tun ssh HOST\n' >&2; return 2;
            }
            ;;
        local)
            if [ "$#" -gt 0 ]; then
                [ "$#" -ge 2 ] && [ "$#" -le 4 ] || {
                    printf 'Usage: tun local HOST LOCAL_PORT DEST_PORT [DEST_HOST] [BIND_ADDR]\n' >&2
                    return 2
                }
                local_port="$1"; remote_port="$2"
                remote_host="${3:-127.0.0.1}"
                local_bind="${4:-127.0.0.1}"
            else
                printf 'Local Bind Address [127.0.0.1]: '
                IFS= read -r local_bind || return 1
                local_bind="${local_bind:-127.0.0.1}"
                printf 'Local Port: '
                IFS= read -r local_port || return 1
                printf 'Destination Host [127.0.0.1]: '
                IFS= read -r remote_host || return 1
                remote_host="${remote_host:-127.0.0.1}"
                printf 'Destination Port: '
                IFS= read -r remote_port || return 1
            fi
            option='-L'
            forward="$local_bind:$local_port:$remote_host:$remote_port"
            ;;
        reverse)
            if [ "$#" -gt 0 ]; then
                [ "$#" -ge 2 ] && [ "$#" -le 4 ] || {
                    printf 'Usage: tun reverse HOST REMOTE_PORT LOCAL_PORT [LOCAL_HOST] [REMOTE_BIND]\n' >&2
                    return 2
                }
                remote_port="$1"; local_port="$2"
                local_host="${3:-127.0.0.1}"
                remote_bind="${4:-127.0.0.1}"
            else
                printf 'Remote Bind Address [127.0.0.1]: '
                IFS= read -r remote_bind || return 1
                remote_bind="${remote_bind:-127.0.0.1}"
                printf 'Remote Port: '
                IFS= read -r remote_port || return 1
                printf 'Local Destination Host [127.0.0.1]: '
                IFS= read -r local_host || return 1
                local_host="${local_host:-127.0.0.1}"
                printf 'Local Port: '
                IFS= read -r local_port || return 1
            fi
            option='-R'
            forward="$remote_bind:$remote_port:$local_host:$local_port"
            ;;
        socks)
            [ "$#" -le 1 ] || {
                printf 'Usage: tun socks HOST [LOCAL_PORT]\n' >&2; return 2
            }
            if [ "$#" -gt 0 ]; then
                local_port="$1"
            else
                printf 'Local SOCKS Port [9090]: '
                IFS= read -r local_port || return 1
            fi
            local_port="${local_port:-9090}"
            option='-D'
            forward="127.0.0.1:$local_port"
            ;;
    esac

    if [ "$type" != ssh ]; then
        [ -n "$local_port" ] && { [ "$type" = socks ] || [ -n "$remote_port" ]; } || {
            printf 'Port cannot be empty\n' >&2
            return 1
        }
        for port in "$local_port" "$remote_port"; do
            [ -n "$port" ] || continue
            case "$port" in
                *[!0-9]*|'') printf 'Invalid port: %s\n' "$port" >&2; return 1 ;;
            esac
            if [ "${#port}" -gt 5 ] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
                printf 'Invalid port: %s\n' "$port" >&2
                return 1
            fi
        done
    fi

    printf '\nConnecting to %s...\n' "$server"
    [ -z "$forward" ] || printf 'Tunnel: %s %s\n' "$option" "$forward"

    if [ "$has_key" = yes ]; then
        if [ "$type" = ssh ]; then
            ssh "$server"
        else
            ssh -N -T -o ExitOnForwardFailure=yes \
                "$option" "$forward" "$server"
        fi
    else
        printf 'Authenticating as %s (%s)\n' "$username" "$auth_source"
        if [ "$type" = ssh ]; then
            sshpass -d 3 ssh \
                -o PubkeyAuthentication=no \
                -o PreferredAuthentications=password,keyboard-interactive \
                -l "$username" "$server" 3<<< "$password"
        else
            sshpass -d 3 ssh -N -T \
                -o ExitOnForwardFailure=yes \
                -o PubkeyAuthentication=no \
                -o PreferredAuthentications=password,keyboard-interactive \
                -l "$username" \
                "$option" "$forward" "$server" 3<<< "$password"
        fi
    fi
    exit_code=$?
    unset password fields
    return "$exit_code"
}
